NODE_ENV=development
LOG_LEVEL=info
PORT=5002

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_mmc

BCRYPT_SALT_ROUNDS=12

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=10d
JWT_REFRESH_EXPIRES_IN=365d

FRONTEND_URLS=http://localhost:3000

REDIS_URL=redis://localhost:6379

NODEMAILER_USER=
NODEMAILER_PASS=

DEVICE_SECRET=change-me-device-secret

# BulkSMSBD.net SMS gateway credentials (https://bulksmsbd.net)
# Get your api_key + senderid from your BulkSMSBD account dashboard.
BULK_SMS_API_KEY=
BULK_SMS_SENDER_ID=
# Override only if BulkSMSBD rotates their host. Defaults to http://bulksmsbd.net/api
BULK_SMS_BASE_URL=http://bulksmsbd.net/api

SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_STUDENT_ID=SMC-ADMIN-001
SUPER_ADMIN_PASSWORD=ChangeMe123!